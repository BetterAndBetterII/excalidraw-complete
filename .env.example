# Excalidraw Complete 环境配置示例
# 复制此文件为 .env 并填入实际值

# ===================
# 存储配置
# ===================

# 存储类型: sqlite, filesystem, s3, memory
STORAGE_TYPE=sqlite

# SQLite 数据库文件路径
DATA_SOURCE_NAME=./excalidraw.db

# 本地文件系统存储路径（当 STORAGE_TYPE=filesystem 时使用）
# LOCAL_STORAGE_PATH=/tmp/excalidraw/

# AWS S3 存储桶名称（当 STORAGE_TYPE=s3 时使用）
# S3_BUCKET_NAME=your-bucket-name

# ===================
# GitHub OAuth 配置
# ===================

# GitHub OAuth 应用的 Client ID
# 在 https://github.com/settings/developers 创建应用获取
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth 应用的 Client Secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ===================
# 应用配置
# ===================

# 应用的基础URL（用于OAuth回调）
# 开发环境通常为 http://localhost:3002
# 生产环境为你的域名，如 https://excalidraw.yourdomain.com
BASE_URL=http://localhost:3002

# ===================
# 服务器配置
# ===================

# 服务器监听地址
# 默认为 :3002，可以修改为其他端口
# LISTEN_ADDR=:3002

# 日志级别: debug, info, warn, error, fatal, panic
# LOG_LEVEL=info

# ===================
# 安全配置（生产环境）
# ===================

# 是否启用 HTTPS（生产环境建议启用）
# ENABLE_HTTPS=false

# SSL 证书文件路径
# SSL_CERT_FILE=/path/to/cert.pem

# SSL 私钥文件路径
# SSL_KEY_FILE=/path/to/key.pem

# ===================
# 数据库配置（高级）
# ===================

# 数据库连接池大小
# DB_MAX_OPEN_CONNECTIONS=25
# DB_MAX_IDLE_CONNECTIONS=25

# 连接超时时间（秒）
# DB_CONNECTION_TIMEOUT=30

# ===================
# 会话配置
# ===================

# 会话过期时间（小时）
# SESSION_EXPIRY_HOURS=168  # 7天

# 会话清理间隔（小时）
# SESSION_CLEANUP_INTERVAL_HOURS=1

# ===================
# 功能开关
# ===================

# 是否允许匿名访问（不建议在生产环境开启）
# ALLOW_ANONYMOUS=false

# 是否允许公开画布
# ALLOW_PUBLIC_CANVAS=true

# 每用户最大画布数量（0表示无限制）
# MAX_CANVAS_PER_USER=100

# ===================
# 监控和日志
# ===================

# 是否启用性能监控
# ENABLE_METRICS=false

# 是否启用请求日志
# ENABLE_REQUEST_LOGGING=true

# 日志文件路径（空则输出到控制台）
# LOG_FILE_PATH=

# ===================
# 备份配置
# ===================

# 是否启用自动备份
# ENABLE_AUTO_BACKUP=false

# 备份间隔（小时）
# BACKUP_INTERVAL_HOURS=24

# 备份保留天数
# BACKUP_RETENTION_DAYS=30

# 备份存储路径
# BACKUP_PATH=./backups